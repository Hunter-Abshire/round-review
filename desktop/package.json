{
  "name": "round-review-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell for round-review",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && esbuild src/renderer/app.ts --bundle --platform=browser --format=iife --outfile=dist/renderer/app.js && node scripts/copy-static.js",
    "start": "npm run build && electron .",
    "test": "jest",
    "lint": "eslint src && prettier --check src",
    "format": "prettier --write src",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.5.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "electron": "^32.0.0",
    "esbuild": "^0.23.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.8.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.4",
    "typescript": "^5.5.4"
  }
}
